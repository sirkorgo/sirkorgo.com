---
// src/layouts/default.astro
import "../css/global.scss";
import Navbar from "../components/topbar.astro";
import Footer from "../components/footer.astro";
import Preload from "../components/preload.astro";

interface Props {
  title?: string;
  desc?: string;
  colors?: string;
  url?: string;
}

const {
  title = "sirkorgo.com",
  desc = "Home of Sirkorgo, a shapeshifting corgi, and his friends. Read comics about the world he lives in, Cloudspace, and read blog posts from the creator.",
  colors = "default",
  url = Astro.url.pathname,
} = Astro.props;

const pageTitle = title === "Index" ? "sirkorgo.com" : `${title} (sirkorgo.com)`;
const footerTitle = title;
---

<!doctype html>
<html id="html" class={`${colors} light `} lang="en-US">
  <head>
    <meta charset="utf-8" />
    <Preload />
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline={true} defer src="https://u.widget.st/ar.js"></script>
    <title>{pageTitle}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Manrope:wght@200..800&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content="sirkorgo.com" />
    <meta name="description" content={desc} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={`https://www.sirkorgo.com${url}`} />
    <meta property="og:image" content="https://www.sirkorgo.com/img/emblems/thegang.webp" />
  </head>

  <body>
    <div class="bg base"></div>
    <div class="bg drift"><div class="rot"><div class="mv"></div></div></div>

    <main>
      <Navbar />
      <slot />
      <Footer title={footerTitle} />
    </main>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const P = {
          corgi:
            "M6 6L22 13L42 13L58 6L56 32Q56 54 32 54Q8 54 8 32ZM22 30a3 3 0 1 0 6 0a3 3 0 1 0-6 0M36 30a3 3 0 1 0 6 0a3 3 0 1 0-6 0",
          star: "M32 4L38.8 22.7L58.6 23.3L42.9 35.6L48.5 54.7L32 43.5L15.5 54.7L21.1 35.6L5.4 23.3L25.2 22.7Z",
          cloud: "M16 50Q4 50 4 40Q4 30 15 30Q18 16 32 16Q46 16 49 28Q60 28 60 40Q60 50 50 50Z",
        };
        const slot = (k, x, y) =>
          `<path transform='translate(${x + 10} ${y + 10}) scale(.7)' fill-rule='evenodd' d='${P[k]}'/>`;
        const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'>${slot("corgi", 0, 0)}${slot("star", 64, 0)}${slot("cloud", 0, 64)}${slot("corgi", 64, 64)}</svg>`;
        root.style.setProperty("--tileurl", `url("data:image/svg+xml,${encodeURIComponent(svg)}")`);
      })();
    </script>
  </body><script is:inline src="https://cursor-party.sirkorgo.workers.dev/cursors.js"></script>
</html>
