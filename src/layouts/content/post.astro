---
import Layout from "../default.astro";
import Comments from "../../components/comments.astro";

interface Props {
  title?: string;
  date?: Date | string;
  author?: string;
  excerpt?: string;
}

const { title = "sirkorgo.com", date, author = "sirkorgo", excerpt = "" } = Astro.props;

const pageTitle = `${title} (sirkorgo.com)`;
const footerTitle = title;
const formattedDate = date
  ? new Date(date).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    })
  : "";
---

<Layout>
  <div id="post-content">
    <main class="page">
      <section class="pageHeader">
        <a href="/blog"><button class="button-muted">← Go Back</button></a>
        <p>
          <b>{formattedDate} • {title}</b>
        </p>
      </section>
      <hr />
      <section>
        <h2>{title}</h2>
        <p>
          Posted on {formattedDate}, by {author}
        </p>
        <br />
        <slot />
      </section>
    </main>
    <Comments />
  </div>
</Layout>
