---
import Layout from "../layouts/default.astro";
import Marquee from "../components/marquee.astro";
import Banner from "../components/banner.astro";
import Gang from "../components/gang.astro";
export const title = "Index";
---

<Layout title={title}>
  <div class="content">
    <div class="welcome">
      <span>
        <h3 class="welcome-text" style="margin: 0;">Heyo! Welcome to sirkorgo.com</h3>
        <p class="welcome-text">
          A whimsyful site for my OCs: Sirkorgo, Widget, Mono, and their friends.<br />See my art,
          comics, and read about my tech ramblings on the blog. <br /><a
            class="welcome-text"
            style="color: white;"
            href="/about">
            Learn more
          </a>
        </p>
      </span>
      <img width="200px" src="/img/emblems/gang2.png" />
    </div>
    <div class="index-grid">
      <div class="index-main">
        <section class="section">
          <div id="recent-blogposts">
            <h1 style="margin: 0;">Blog Posts</h1>
            <div id="hero-blog" class="subsection hero-blogpost"></div>
            <div id="recent-blog">
              <div class="subsection recent-blogpost"></div>
              <div class="subsection recent-blogpost"></div>
            </div>
          </div>
        </section>
        <section class="section">
          <h1 style="margin: 0;">Artwork & Comics</h1>
          <div id="latest-art">
            <div id="hero-art" class="subsection"></div>
            <div id="latest-comics">
              <div class="subsection" id="latest-cloudspace">
                <h3 class="caption" style="margin: 0;">Cloudspace</h3>
                <p>Chapter 4 out now</p>
              </div>
              <div class="subsection" id="latest-meantime">
                <h3 class="caption" style="margin: 0;">Sirkorgo! In the Meantime</h3>
                <p>Chapter 6 out now</p>
              </div>
            </div>
          </div>
        </section>
        <section class="section">
          <h1 style="margin: 0;">Meet the cast</h1>
          <Gang />
        </section>
      </div>
      <div class="index-sidebar">
        <section class="sidesection">
          <span class="section-title">
            <h3 class="caption" style="color: white; margin: 0 !important;">now</h3>
          </span>
          <div><Banner /></div>
        </section>
        <section class="sidesection">
          <span class="section-title">
            <h3 class="caption" style="color: white; margin: 0 !important;">add my button!</h3>
          </span>
          <span
            style="
              text-align: center;
              display: flex;
              flex-direction: column;
              justify-content: center;
              margin-top: 5px;
            ">
            <a href="https://www.sirkorgo.com" target="_blank">
              <img
                src="/img/bumper.gif"
                alt="sirkorgo.com Site Bumper"
                loading="lazy"
                decoding="async"
              />
            </a>
            <br />
            <code style="font-size: 9.5px">
              &lt;a href="https://www.sirkorgo.com" target="_blank"&gt;&lt;img
              src="https://www.sirkorgo.com/img/bumper.gif"&gt;&lt;/a&gt;
            </code>
            <p style="margin-bottom: 0"><small>hotlinking recommended!</small></p>
          </span>
        </section>
        <section class="sidesection">
          <span class="section-title">
            <h3 class="caption" style="color: white; margin: 0 !important;">neighbors</h3>
          </span>
          <div style="padding: 10px;">
            <div><Marquee /></div>
          </div>
        </section>
      </div>
    </div>
    <section class="section">
      <h1 style="margin: 0;">Changelog</h1>
    </section>
  </div>
</Layout>
