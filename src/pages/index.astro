---
import Layout from "../layouts/default.astro";
import Marquee from "../components/marquee.astro";
import Banner from "../components/banner.astro";
import Gang from "../components/gang.astro";
export const title = "Index";

import { getCollection } from "astro:content";
const blog = await getCollection("posts");
const art = await getCollection("art");
const comics = await getCollection("comics");

function Excerpt(markdown: string, maxLength = 200) {
  if (!markdown) return "";

  const plainText = markdown
    .replace(/<[^>]*>/g, "")
    .replace(/!\[.*?\]\(.*?\)/g, "")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[#*`>_~-]+/g, "")
    .replace(/\s+/g, " ")
    .trim();

  if (plainText.length <= maxLength) return plainText;
  return plainText.slice(0, maxLength).trim() + "...";
}

const sortedPosts = [...blog].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const hero = sortedPosts[0];
const recentBlogs = sortedPosts.slice(2, 4);

const sortedArt = [...art].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestArt = sortedArt[0];

const allComics = await getCollection("comics");

function getLatestComicChapter(seriesName: string): CollectionEntry<"comics"> | undefined {
  return allComics
    .filter((entry) => entry.data.series === seriesName)
    .sort((a, b) => {
      if (b.data.chapter !== a.data.chapter) {
        return b.data.chapter - a.data.chapter;
      }
      return b.data.date.valueOf() - a.data.date.valueOf();
    })[0];
}

const latestMeantime = getLatestComicChapter("Sirkorgo! In the Meantime...");
const latestCloudspace = getLatestComicChapter("Cloudspace");
---

<Layout title={title}>
  <div class="content">
    <div class="welcome">
      <div>
        <h3 class="welcome-text">Heyo! Welcome to sirkorgo.com</h3>
        <p class="welcome-text">
          A whimsyful site for my OCs: Sirkorgo, Widget, Mono, and their friends.<br />
          See my art, comics, and read about my tech ramblings on the blog.<br />
          <a href="/about">Learn more</a>
        </p>
      </div>
      <img class="welcome-art" src="/img/emblems/gang2.png" alt="" />
    </div>
    <div class="index-grid">
      <div class="index-main">
        <section class="section">
          <div id="recent-blogposts">
            <h1 style="margin: 0;">Blog Posts</h1>
            {
              hero && (
                <a style="all: unset;" href={`/blog/${hero.id}`}>
                  <div id="hero-blog" class="subsection recent-blogpost">
                    <span>
                      <h2>{hero.data.title}</h2>
                      <p>{Excerpt(hero.body)}</p>
                    </span>
                    <span class="post-date">
                      <p>{hero.data.date.toLocaleDateString()}</p>
                    </span>
                  </div>
                </a>
              )
            }
            <div id="recent-blog">
              {
                recentBlogs.map((post) => (
                  <div class="subsection recent-blogpost">
                    {" "}
                    <span>
                      <h2>{post.data.title}</h2>
                      <p>{Excerpt(post.body)}</p>
                    </span>
                    <span class="post-date">
                      <p>{post.data.date.toLocaleDateString()}</p>
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </section>
        <section class="section">
          <h1 style="margin: 0;">Artwork & Comics</h1>
          <div id="latest-art">
            <div id="hero-art" class="subsection">
              {
                latestArt && (
                  <>
                    <a href={`/art/${latestArt.id}`}>
                      <img src={latestArt.data.image} alt={latestArt.data.title} />
                      <div class="art-meta">
                        <p class="art-date">{latestArt.data.date.toLocaleDateString()}</p>
                        <h2>{latestArt.data.title}</h2>
                      </div>
                    </a>
                  </>
                )
              }
            </div>
            <div id="latest-comics">
              {
                latestCloudspace && (
                  <a
                    href={`/comics/${latestCloudspace.id}`}
                    class="subsection"
                    id="latest-cloudspace">
                    <span class="comic-meta">
                      <p>Chapter {latestCloudspace.data.chapter}</p>
                      <h3 class="caption" style="margin: 0;">
                        Cloudspace
                      </h3>
                    </span>
                    <img
                      src="/img/banners/cloudspace-thumb.gif"
                      loading="lazy"
                      decoding="async"
                      alt="Cloudspace Thumbnail"
                      width="128"
                      height="128"
                      class="comic-thumb"
                    />
                  </a>
                )
              }
              {
                latestMeantime && (
                  <a
                    href={`/comics/${latestMeantime.id}`}
                    class="subsection"
                    id="latest-cloudspace">
                    <span class="comic-meta">
                      <p>Chapter {latestMeantime.data.chapter}</p>
                      <h3 class="caption" style="margin: 0;">
                        Sirkorgo! In the Meantime...
                      </h3>
                    </span>
                    <img
                      src="/img/banners/meantime-thumb.gif"
                      loading="lazy"
                      decoding="async"
                      alt="Cloudspace Thumbnail"
                      width="128"
                      height="128"
                      class="comic-thumb"
                    />
                  </a>
                )
              }
            </div>
          </div>
        </section>
        <section class="section">
          <h1 style="margin: 0;">Meet the cast</h1>
          <Gang />
        </section>
      </div>
      <div class="index-sidebar">
        <section class="sidesection">
          <span class="section-title">
            <h3 class="caption" style="color: white; margin: 0 !important;">now</h3>
          </span>
          <div><Banner /></div>
        </section>
        <section class="sidesection">
          <span class="section-title">
            <h3 class="caption" style="color: white; margin: 0 !important;">add my button!</h3>
          </span>
          <span
            style="
              text-align: center;
              display: flex;
              flex-direction: column;
              justify-content: center;
              margin-top: 5px;
            ">
            <a href="https://www.sirkorgo.com" target="_blank">
              <img
                src="/img/bumper.gif"
                alt="sirkorgo.com Site Bumper"
                loading="lazy"
                decoding="async"
              />
            </a>
            <br />
            <code style="font-size: 9.5px">
              &lt;a href="https://www.sirkorgo.com" target="_blank"&gt;&lt;img
              src="https://www.sirkorgo.com/img/bumper.gif"&gt;&lt;/a&gt;
            </code>
            <p style="margin-bottom: 0"><small>hotlinking recommended!</small></p>
          </span>
        </section>
        <section class="sidesection">
          <span class="section-title">
            <h3 class="caption" style="color: white; margin: 0 !important;">neighbors</h3>
          </span>
          <div style="padding: 10px;">
            <div><Marquee /></div>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>
