<span class="theme-date">
  <h2 id="now-date" style="margin: 0;">Monoday, Sirkorgurary 1st</h2>
  <p style="margin: 0;" class="footer-text">Autumn's Here!</p>
</span>
<script is:inline async>
  const now = new Date();

  // Format the weekday, month, and day (e.g., "Friday, November 13")
  const weekday = now.toLocaleDateString("en-US", { weekday: "long" });
  const month = now.toLocaleDateString("en-US", { month: "long" });
  const day = now.getDate();

  // Add the ordinal suffix ("st", "nd", "rd", or "th")
  function getOrdinal(n) {
    const suffixes = ["th", "st", "nd", "rd"];
    const v = n % 100;
    return n + (suffixes[(v - 20) % 10] || suffixes[v] || suffixes[0]);
  }

  // Insert the formatted date into the h2 tag
  document.getElementById("now-date").innerHTML = `${weekday},<br> ${month} ${getOrdinal(day)}`;
</script>
