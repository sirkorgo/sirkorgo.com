---
const pathname = Astro.url.pathname;
interface Props {
  hideBanner?: boolean;
}
---

<section id="topbar">
  <a href="/">
    <div id="nav-header">
      <span class="nh_left">
        <p>sirkorgo.com</p>
      </span>
      <span class="nh_right">
        <img src="/img/sitelogo.webp" width="49px" height="40px" alt="Site Logo" />
      </span>
    </div>
  </a>
  <nav>
    <span class="nb_left">
      <a href="/about">
        <button class:list={["nav-btn", { active: pathname.startsWith("/about") }]}>bio</button>
      </a>
      <a href="/portfolio">
        <button class:list={["nav-btn", { active: pathname.startsWith("/portfolio") }]}>
          portfolio
        </button>
      </a>
      <a href="/blog">
        <button class:list={["nav-btn", { active: pathname.startsWith("/blog") }]}>blog</button>
      </a>
      <a href="/comics">
        <button class:list={["nav-btn", { active: pathname.startsWith("/comics") }]}>comics</button>
      </a>
      <a href="/guestbook">
        <button class:list={["nav-btn", { active: pathname.startsWith("/guestbook") }]}>
          guestbook
        </button>
      </a>
    </span>
    <span class="nb_right">
      <span class="stats-counter">
        <p style="margin: 0px 0px 0px 0px" id="visitors">#⋯</p>
      </span>
    </span>
  </nav>
</section>
<script>
  import "../js/navbar.js";
</script>
